FROM python:3.11-slim

WORKDIR /app

# Install dependencies: libpq-dev, gcc, nodejs, npm
RUN apt-get update && \
    apt-get install -y libpq-dev gcc curl && \
    curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs

# Install server dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install web dependencies
COPY server/web/package.json server/web/
# Remove package-lock.json and node_modules if they exist (to avoid npm bugs)
RUN rm -f /app/server/web/package-lock.json && rm -rf /app/server/web/node_modules
RUN cd server/web && npm install

# Don't copy source code - will be mounted as volume for live development

EXPOSE 8000 5173

# Use a script to run both the Python server and Vite dev server with hot reloading
CMD ["sh", "-c", "cd /app/server/web && npm run dev & cd /app && python manage.py migrate && python manage.py runserver 0.0.0.0:8000"]
