<svg width="800" height="480" viewBox="0 0 800 480" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <style>
            .axis {
                stroke: #333;
                stroke-width: 1;
            }
            .grid-line {
                stroke: #ccc;
                stroke-width: 0.5;
                stroke-dasharray: 2,2;
            }
            .chart-line {
                fill: none;
                stroke: #000;
                stroke-width: 2;
            }
            .uv-area {
                fill: #999;
                opacity: 0.3;
            }
            .axis-label {
                fill: #000;
                font-size: 12px;
                text-anchor: middle;
                font-family: Arial, sans-serif;
            }
            .axis-label-y {
                fill: #000;
                font-size: 12px;
                text-anchor: end;
                font-family: Arial, sans-serif;
            }
            .title {
                fill: #000;
                font-size: 16px;
                font-weight: bold;
                text-anchor: middle;
                font-family: Arial, sans-serif;
            }
            .temp-label {
                fill: #000;
                font-size: 11px;
                font-weight: bold;
                text-anchor: middle;
                font-family: Arial, sans-serif;
            }
            .uv-label {
                fill: #000;
                font-size: 11px;
                font-weight: bold;
                text-anchor: middle;
                font-family: Arial, sans-serif;
            }
            .precip-line {
                fill: none;
                stroke: #000;
                stroke-width: 1.5;
                stroke-dasharray: 4,4;
            }
            .pill-shape {
                fill: #000;
                stroke: none;
            }
            .weekly-temp-label {
                fill: #000;
                font-size: 14px;
                font-weight: bold;
                text-anchor: middle;
                font-family: Arial, sans-serif;
            }
            .day-label {
                fill: #000;
                font-size: 12px;
                text-anchor: middle;
                font-family: Arial, sans-serif;
            }
            .sidebar-text {
                fill: #000;
                font-family: Arial, sans-serif;
            }
            .current-temp {
                font-size: 32px;
                font-weight: bold;
            }
            .current-date {
                font-size: 18px;
            }
        </style>
    </defs>

    <!-- Background -->
    <rect width="800" height="480" fill="white"/>

    <!-- Sidebar with current temperature and date -->
    <g id="sidebar">
        {% if current_temp is not None %}
        <!-- Weather icon (embedded SVG) - centered horizontally, positioned near top of sidebar -->
        <g id="weather-icon" transform="translate(100, 80)">
            {{ current_weather_icon_svg|safe }}
        </g>
        <!-- Current temperature - below icon -->
        <text x="100" y="140" class="sidebar-text current-temp" text-anchor="middle">{{ current_temp }}°F</text>
        {% endif %}
        <!-- Current date - below temperature -->
        <text x="100" y="180" class="sidebar-text current-date" text-anchor="middle">{{ current_date }}</text>
    </g>

    <!-- Grid lines -->
    <g id="y-axis">
        {% for grid_line in grid_lines %}
        <line x1="{{ x_axis_start }}" y1="{{ grid_line.y_pos }}" x2="{{ x_axis_end }}" y2="{{ grid_line.y_pos }}" class="grid-line"/>
        {% endfor %}
    </g>

    <!-- X-axis labels -->
    <g id="x-axis">
        {% for hour_label in hour_labels %}
        <text x="{{ hour_label.x_pos }}" y="{{ x_label_y }}" class="axis-label">{{ hour_label.label }}</text>
        {% endfor %}
    </g>

    <!-- X-axis only (y-axis removed) -->
    <line x1="{{ x_axis_start }}" y1="{{ y_axis_end }}" x2="{{ x_axis_end }}" y2="{{ y_axis_end }}" class="axis"/>

    <!-- UV index shaded area (secondary y-axis, no line) -->
    <path d="{{ uv_path_data }}" class="uv-area"/>

    <!-- Chart line -->
    <path d="{{ path_data }}" class="chart-line"/>

    <!-- Precipitation probability dotted line (third y-axis) -->
    {% if precip_path_data %}
    <path d="{{ precip_path_data }}" class="precip-line"/>
    {% endif %}

    <!-- Min temperature label -->
    <text x="{{ min_temp_label.x }}" y="{{ min_temp_label.y }}" class="temp-label">{{ min_temp_label.temp }}°F</text>

    <!-- Max temperature label -->
    <text x="{{ max_temp_label.x }}" y="{{ max_temp_label.y }}" class="temp-label">{{ max_temp_label.temp }}°F</text>

    <!-- Peak UV index label -->
    <text x="{{ peak_uv_label.x }}" y="{{ peak_uv_label.y }}" class="uv-label">{{ peak_uv_label.uv_index }} UV</text>

    <!-- Weekly Forecast Chart -->
    {% if weekly_chart_data %}
    <!-- Weekly chart x-axis -->
    <line x1="{{ x_axis_start }}" y1="{{ weekly_y_axis_end }}" x2="{{ x_axis_end }}" y2="{{ weekly_y_axis_end }}" class="axis"/>

    <!-- Pill shapes for each day -->
    {% for day in weekly_chart_data %}
    <!-- Pill shape (Apple-style rounded rectangle spanning from low to high) -->
    <rect x="{{ day.pill_x }}" y="{{ day.pill_y }}" width="{{ day.pill_width }}" height="{{ day.pill_height }}" rx="{{ day.pill_radius }}" ry="{{ day.pill_radius }}" class="pill-shape"/>

    <!-- Low temperature label -->
    <text x="{{ day.x_pos }}" y="{{ day.low_label_y }}" class="weekly-temp-label">{{ day.low_temp }}°F</text>

    <!-- High temperature label -->
    <text x="{{ day.x_pos }}" y="{{ day.high_label_y }}" class="weekly-temp-label">{{ day.high_temp }}°F</text>

    <!-- Day label -->
    <text x="{{ day.x_pos }}" y="{{ day.day_label_y }}" class="day-label">{{ day.day_name }}</text>
    {% endfor %}
    {% endif %}
</svg>
