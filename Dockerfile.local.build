FROM python:3.11-slim

WORKDIR /app

# Install dependencies: libpq-dev, gcc, nodejs, npm, cairo (for CairoSVG)
# Minimal CairoSVG requirements: libcairo2, libcairo2-dev, python3-dev, libffi-dev
# Pango libraries needed for text rendering in SVG
RUN apt-get update && \
    apt-get install -y libpq-dev gcc curl python3-dev libffi-dev libcairo2 libcairo2-dev libpango1.0-dev libpangocairo-1.0-0 && \
    curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs

# Install server dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install web dependencies
RUN mkdir -p /app/server/static/
COPY server/web/package*.json server/web/
RUN cd server/web && npm install

COPY . .

EXPOSE 8000

CMD ["sh", "-c", "cd /app/server/web && npm run build && cd /app && python manage.py migrate && python manage.py collectstatic --noinput && gunicorn server.config.wsgi:application --bind 0.0.0.0:8000 --access-logfile - --error-logfile -"]
